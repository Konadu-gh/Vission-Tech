root {
  --green: #006B3D;
  --yellow: #FFD700;
  --black: #000;
  --white: #FFFFFF;
}

* { box-sizing: border-box; scroll-behavior: smooth; }

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  margin: 0;
  color: var(--black);
  background: var(--white);
}

header {
  background: var(--green);
  color: var(--white);
  padding: 15px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo { height: 45px; }

nav a {
  color: var(--white);
  margin-left: 20px;
  text-decoration: none;
  font-weight: 600;
}
nav a:hover { color: var(--yellow); }

.hero {
  text-align: center;
  padding: 100px 20px;
  background: linear-gradient(135deg, var(--green) 0%, var(--yellow) 100%);
  color: var(--white);
}
.hero h1 { font-size: 3em; margin: 0; }

.btn {
  background: var(--black);
  color: var(--white);
  padding: 14px 30px;
  text-decoration: none;
  border-radius: 8px;
  display: inline-block;
  margin-top: 20px;
  font-weight: bold;
}
.btn-whatsapp { background: #25D366; }
.btn:hover { opacity: 0.9; }

section { padding: 60px 5%; }
h2 { text-align: center; color: var(--green); font-size: 2.2em; }

.cards { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; }
.card {
  background: #f9f9f9;
  border-top: 4px solid var(--yellow);
  padding: 25px;
  width: 300px;
  border-radius: 10px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

#products { background: #f9f9f9; }
.gallery { 
  display: grid; 
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
  gap: 20px; 
  margin-top: 30px;
}
.product {
  background: var(--white);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  text-align: center;
  border-bottom: 4px solid var(--yellow);
}
.product img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}
.product h3 { color: var(--green); margin: 10px 0 5px 0; }

table { width: 100%; max-width: 600px; margin: 20px auto; border-collapse: collapse; }
th, td { padding: 12px; border-bottom: 1px solid #ddd; text-align: left; }
th { background: var(--green); color: var(--white); }

.map { margin-top: 20px; border-radius: 10px; overflow: hidden; }

footer {
  background: var(--black);
  color: var(--white);
  text-align: center;
  padding: 20px;
}

.whatsapp-float {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25D366;
  color: white;
  padding: 15px 18px;
  border-radius: 50%;
  font-size: 24px;
  text-decoration: none;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
