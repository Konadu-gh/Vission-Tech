<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eben & Co. Limited - Professional Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
body{background:#0a0a0a;color:#fff}
header{background:#111;padding:15px 30px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #00FF00;position:sticky;top:0;z-index:1000}
.brand{display:flex;align-items:center;gap:12px}
.brand img{height:50px;border-radius:50%;border:2px solid #FFD700}
.brand h1{color:#FFD700;font-size:1.4rem}
.brand p{color:#00FF00;font-size:0.85rem}
.brand a{color:#00FF00;font-size:0.8rem;text-decoration:none}
.menu-btn{font-size:1.8rem;color:#00FF00;cursor:pointer;display:none}

nav{background:#1a1a1a;padding:14px 30px;display:flex;gap:30px;border-bottom:1px solid #333;overflow-x:auto}
nav a{color:#ccc;text-decoration:none;font-weight:600;padding-bottom:8px;cursor:pointer;white-space:nowrap}
nav a.active{color:#00FF00;border-bottom:3px solid #00FF00}

/* SEARCH BAR */
.search-bar{padding:20px 30px;background:#1a1a1a}
.search-bar input{width:100%;padding:12px 20px;border-radius:25px;border:2px solid #00FF00;background:#222;color:#fff;font-size:1rem}
.search-bar input::placeholder{color:#777}

/* SSNIIT SIDE MENU */
.side-menu{position:fixed;top:0;right:-100%;width:85%;max-width:380px;height:100%;background:#fff;color:#000;z-index:99999;transition:0.4s;overflow-y:auto;padding:25px}
.side-menu.active{right:0}
.side-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:99998}
.side-overlay.active{display:block}
.close-btn{font-size:2rem;cursor:pointer;float:right;color:#555;margin-bottom:20px}
.side-menu h3{font-size:1.1rem;padding:15px 0;border-bottom:1px solid #eee;cursor:pointer;font-weight:700}
.dropdown-btn{display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #eee;cursor:pointer;font-weight:700}
.dropdown-content{display:none;padding-left:15px}
.dropdown-content a{display:block;padding:12px 0;color:#555;text-decoration:none;font-size:0.9rem}
.side-location{margin-top:30px;padding-top:20px;border-top:2px solid #eee;font-weight:700}
.side-socials{display:flex;gap:15px;margin-top:15px}
.side-socials i{width:35px;height:35px;border-radius:50%;background:#f1f1f1;display:flex;align-items:center;justify-content:center;color:#000}

/* AUTO SLIDESHOW - FROM YOUR CODE */
.slideshow{position:relative;width:100%;height:500px;border-radius:20px;overflow:hidden;margin-bottom:30px;border:2px solid #00FF00}
.slide{display:none;width:100%;height:100%;position:absolute}
.slide img{width:100%;height:100%;object-fit:cover}
.slide.active{display:block;animation:fade 1s}
@keyframes fade{from{opacity:.4}to{opacity:1}}
.slide-text{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,0.8));padding:30px;color:#fff}
.slide-text h2{color:#FFD700;font-size:1.8rem}
.dots{text-align:center;position:absolute;bottom:15px;width:100%}
.dot{height:12px;width:12px;margin:0 5px;background:#555;border-radius:50%;display:inline-block;cursor:pointer}
.dot.active{background:#00FF00}

.page{display:none;padding:30px;max-width:1400px;margin:auto}
.page.active{display:block}
h2.section-title{color:#FFD700;margin-bottom:25px;font-size:1.8rem}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
.company-card{background:#002200;padding:25px;border-radius:14px;border:2px solid #00FF00}
.company-card h3{color:#FFD700}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:25px}
.product-card{background:#1a1a1a;padding:15px;border-radius:14px;border:1px solid #333}
.product-card img{width:100%;height:220px;object-fit:cover;border-radius:10px}
.product-card h4{color:#FFD700;margin-top:10px}
.stock{color:#00FF00;font-size:0.85rem;font-weight:bold}
.news-item{background:#1a1a1a;padding:20px;border-radius:12px;border-left:4px solid #00FF00;margin-bottom:15px}
.testimonial{background:#1a1a1a;padding:20px;border-radius:12px;border:1px solid #333;margin-bottom:15px}
.testimonial-header{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.testimonial img{width:50px;height:50px;border-radius:50%;border:2px solid #FFD700}

.footer{background:#000;padding:50px 30px;margin-top:50px;border-top:2px solid #00FF00}
.footer-title{color:#fff;font-size:1.4rem;font-weight:bold;margin-bottom:10px;text-align:center}
.footer-line{width:60px;height:3px;background:#FFA500;margin:0 auto 25px}
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;max-width:800px;margin:auto}
.contact-item{display:flex;align-items:center;gap:15px}
.contact-item i{color:#FFA500;font-size:1.3rem}
.btn{background:#00FF00;color:#000;padding:12px 25px;border-radius:8px;border:none;font-weight:bold;cursor:pointer}

@media(max-width:900px){.menu-btn{display:block}nav{display:none}.slideshow{height:300px}}
</style>
</head>
<body>

<header>
  <div class="brand">
    <img src="logo.png">
    <div>
      <h1>Eben & Co. Limited</h1>
      <p>HOLDING COMPANY • ACCRA, GHANA 🇬🇭</p>
      <a href="https://ebenandco.com">www.ebenandco.com</a>
    </div>
  </div>
  <i class="fas fa-bars menu-btn" onclick="openMenu()"></i>
</header>

<!-- SEARCH BAR -->
<div class="search-bar">
  <input type="text" id="searchInput" placeholder="Search products, news, services..." onkeyup="searchAll()">
</div>

<nav>
  <a onclick="showPage('dashboard')" class="active">Dashboard</a>
  <a onclick="showPage('products')">Products</a>
  <a onclick="showPage('news')">News</a>
  <a onclick="showPage('testimonials')">Testimonials</a>
  <a onclick="showPage('profile')">Contact</a>
</nav>

<!-- SSNIIT SIDE MENU -->
<div class="side-overlay" onclick="closeMenu()"></div>
<div class="side-menu" id="sideMenu">
  <i class="fas fa-times close-btn" onclick="closeMenu()"></i>
  <h3 onclick="showPage('dashboard');closeMenu()">Home</h3>
  <div class="dropdown-btn" onclick="toggleDrop('explore')">Explore Eben & Co <i class="fas fa-chevron-down"></i></div>
  <div class="dropdown-content" id="explore">
    <a onclick="showPage('dashboard');closeMenu()">Our Companies</a>
    <a onclick="showPage('products');closeMenu()">Adepa Natural</a>
    <a onclick="showPage('news');closeMenu()">Latest News</a>
  </div>
  <h3 onclick="showPage('testimonials');closeMenu()">Testimonials</h3>
  <h3 onclick="showPage('profile');closeMenu()">Contact Us</h3>
  <div class="side-location">Location: GA-107-4293<br>Accra Ghana</div>
  <div class="side-socials"><i class="fab fa-facebook-f"></i><i class="fab fa-youtube"></i><i class="fab fa-instagram"></i></div>
</div>

<!-- DASHBOARD WITH AUTO SLIDESHOW -->
<div id="dashboard" class="page active">
  <div class="slideshow">
    <div class="slide active"><img src="slide1.jpg"><div class="slide-text"><h2>Adepa Natural Products</h2><p>100% Organic, Made in Ghana</p></div></div>
    <div class="slide"><img src="slide2.jpg"><div class="slide-text"><h2>Vission Tech Services</h2><p>CV Writing & Website Development</p></div></div>
    <div class="slide"><img src="slide3.jpg"><div class="slide-text"><h2>Eben Logistics</h2><p>Fast delivery nationwide</p></div></div>
    <div class="slide"><img src="slide4.jpg"><div class="slide-text"><h2>Our Factory</h2><p>Women empowering women</p></div></div>
    <div class="dots">
      <span class="dot active" onclick="currentSlide(1)"></span>
      <span class="dot" onclick="currentSlide(2)"></span>
      <span class="dot" onclick="currentSlide(3)"></span>
      <span class="dot" onclick="currentSlide(4)"></span>
    </div>
  </div>
  <h2 class="section-title">Our Companies</h2>
  <div class="stats">
    <div class="company-card"><h3>Vission Tech Ghana</h3><p style="color:#00FF00">Website, CV Writing</p></div>
    <div class="company-card"><h3>Adepa Natural</h3><p style="color:#00FF00">12 Natural Products</p></div>
    <div class="company-card"><h3>Eben Logistics</h3><p style="color:#00FF00">Nationwide Delivery</p></div>
  </div>
</div>

<div id="products" class="page"><h2 class="section-title">Adepa Products</h2><div id="productGrid" class="grid"></div></div>
<div id="news" class="page"><h2 class="section-title">Latest News</h2><div id="newsList"></div></div>
<div id="testimonials" class="page"><h2 class="section-title">Customer Testimonials</h2><div id="testimonialList"></div></div>
<div id="profile" class="page"><h2 class="section-title">Contact CEO</h2><div class="company-card"><h3>0537832845</h3><p>kunfum125@gmail.com</p><p>Location: GA-107-4293, Accra Ghana</p></div></div>

<footer class="footer">
  <h3 class="footer-title">Let’s Connect</h3><div class="footer-line"></div>
  <div class="contact-grid">
    <div class="contact-item"><i class="fas fa-map-marker-alt"></i><span>GA-107-4293, Accra Ghana</span></div>
    <div class="contact-item"><i class="fas fa-phone"></i><span>0537832845</span></div>
    <div class="contact-item"><i class="fas fa-envelope"></i><span>kunfum125@gmail.com</span></div>
  </div>
</footer>
 
<script>
function openMenu(){document.getElementById('sideMenu').classList.add('active');document.querySelector('.side-overlay').classList.add('active')}
function closeMenu(){document.getElementById('sideMenu').classList.remove('active');document.querySelector('.side-overlay').classList.remove('active')}
function toggleDrop(id){let el=document.getElementById(id);el.style.display=el.style.display==='block'?'none':'block'}
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.querySelectorAll('nav a').forEach(a=>a.classList.remove('active'));document.getElementById(id).classList.add('active');if(event)event.target.classList.add('active')}

// AUTO SLIDESHOW - CHANGES EVERY 3 SECONDS
let slideIndex = 1;
showSlides(slideIndex);
setInterval(()=>{plusSlides(1)}, 3000);

function plusSlides(n){showSlides(slideIndex += n)}
function currentSlide(n){showSlides(slideIndex = n)}
function showSlides(n){
  let slides = document.getElementsByClassName("slide");
  let dots = document.getElementsByClassName("dot");
  if (n > slides.length) {slideIndex = 1}
  if (n < 1) {slideIndex = slides.length}
  for (let i = 0; i < slides.length; i++) {slides[i].classList.remove("active");}
  for (let i = 0; i < dots.length; i++) {dots[i].classList.remove("active");}
  slides[slideIndex-1].classList.add("active");
  dots[slideIndex-1].classList.add("active");
}

// ALL DATA
const products=[
  {name:"Natural SPF Beru Soap",made:"Kumasi",img:"beru-soap.jpg",stock:24},
  {name:"Shea Hair Pomade",made:"Accra",img:"shea-pomade.jpg",stock:18},
  {name:"Black Soap",made:"Tamale",img:"black-soap.jpg",stock:32},
  {name:"Body Nourishing Oil",made:"Accra",img:"body-oil.jpg",stock:15},
  {name:"Face Glow Cream",made:"Kumasi",img:"face-cream.jpg",stock:20},
  {name:"Herbal Shampoo Bar",made:"Accra",img:"shampoo.jpg",stock:12}
];
const news=[
  {title:"New Factory Opening in Kumasi",date:"Aug 10, 2026",desc:"Expanding production to meet high demand."},
  {title:"Adepa Products Now in 5 Supermarkets",date:"Aug 08, 2026",desc:"Find us at Shoprite and Melcom."},
  {title:"Export to Nigeria Approved",date:"Aug 05, 2026",desc:"First international shipment of 1000 units."}
];
const testimonials=[
  {name:"Ama Serwaa",location:"Accra",text:"Beru Soap cleared my skin in 2 weeks!",img:"customer1.jpg"},
  {name:"Kofi Mensah",location:"Kumasi",text:"Best CV writing service. Got 3 interviews.",img:"customer2.jpg"},
  {name:"Fatima Ibrahim",location:"Tamale",text:"Black soap cleared my acne.",img:"customer3.jpg"}
];

// RENDER
let pHTML='';products.forEach(p=>{pHTML+=`<div class="product-card"><img src="${p.img}"><h4>${p.name}</h4><p>${p.made}</p><p class="stock">Stock: ${p.stock}</p></div>`});document.getElementById('productGrid').innerHTML=pHTML;
let nHTML='';news.forEach(n=>{nHTML+=`<div class="news-item"><h4 style="color:#FFD700">${n.title}</h4><small>${n.date}</small><p>${n.desc}</p></div>`});document.getElementById('newsList').innerHTML=nHTML;
let tHTML='';testimonials.forEach(t=>{tHTML+=`<div class="testimonial"><div class="testimonial-header"><img src="${t.img}"><div><h4 style="color:#FFD700">${t.name}</h4><small>${t.location}</small></div></div><p>"${t.text}"</p></div>`});document.getElementById('testimonialList').innerHTML=tHTML;

// SEARCH FUNCTION
function searchAll(){
  let input = document.getElementById('searchInput').value.toLowerCase();
  document.querySelectorAll('.product-card,.news-item,.testimonial').forEach(el=>{
    el.style.display = el.innerText.toLowerCase().includes(input)? '' : 'none';
  })
}
</script>
</body>
</html>
